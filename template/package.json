{
  "name": "create-outsystems-astro",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit:bun": "bun audit --ignore=GHSA-mh99-v99m-4gvg",
    "audit:deno": "deno audit --ignore CVE-2026-14257",
    "audit:npm": "better-npm-audit audit --exclude GHSA-mh99-v99m-4gvg",
    "audit:pnpm": "pnpm audit --ignore GHSA-mh99-v99m-4gvg",
    "audit:yarn": "yarn npm audit --no-deprecations --ignore 1124334",
    "build": "astro build",
    "dev": "astro dev",
    "format": "prettier . --check",
    "format:write": "prettier  --write .",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint --fix",
    "output": "cross-env NODE_ENV=production astro build && ts-node ./output.ts",
    "output:bun": "cross-env NODE_ENV=production bun run --bun astro build && bun run ./output.ts",
    "output:deno": "cross-env NODE_ENV=production deno run -A npm:astro build && deno run -A ./output.ts",
    "postinstall": "patch-package",
    "preview": "astro preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:bun": "bun run --bun playwright test",
    "test:e2e:deno": "cross-env PW_DISABLE_TS_ESM=true deno run --allow-all npm:playwright test",
    "test:e2e:ui": "bun run --bun playwright test --ui",
    "test:e2e:ui:bun": "playwright test --ui",
    "test:e2e:ui:deno": "cross-env PW_DISABLE_TS_ESM=true deno run --allow-all npm:playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "test:run": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@analogjs/astro-angular": "^2.6.3",
    "@angular/animations": "^22.0.7",
    "@angular/common": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-server": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@astrojs/preact": "^6.0.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/solid-js": "^7.0.1",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.1",
    "@nanostores/preact": "^1.1.0",
    "@nanostores/react": "^1.1.0",
    "@nanostores/solid": "^1.1.1",
    "@nanostores/vue": "^1.1.0",
    "astro": "^7.1.1",
    "islands-integrations": "file:./.integrations",
    "nanostores": "^1.4.0",
    "preact": "^10.29.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.6",
    "tslib": "^2.8.1",
    "twig": "^3.0.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@analogjs/vitest-angular": "^2.6.3",
    "@angular-devkit/architect": "^0.2200.7",
    "@angular-devkit/schematics": "^22.0.1",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@angular/language-service": "^22.0.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@solidjs/testing-library": "^0.8.10",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/twig": "^1.12.17",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "angular-eslint": "^22.1.0",
    "better-npm-audit": "^3.11.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-preact": "^2.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "js-beautify": "^2.0.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "tar": "^7.5.21"
  },
  "resolutions": {
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "tar": "^7.5.21"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
