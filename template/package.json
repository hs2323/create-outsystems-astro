{
  "name": "create-outsystems-astro",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit:bun": "bun audit",
    "audit:deno": "deno audit",
    "audit:npm": "better-npm-audit audit",
    "audit:pnpm": "pnpm audit",
    "audit:yarn": "yarn npm audit --no-deprecations",
    "build": "astro build",
    "dev": "astro dev",
    "format": "prettier . --check",
    "format:write": "prettier  --write .",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint",
    "lint:fix": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint --fix",
    "output": "cross-env NODE_ENV=production astro build && ts-node ./output.ts",
    "output:bun": "cross-env NODE_ENV=production bun run --bun astro build && bun run ./output.ts",
    "output:deno": "cross-env NODE_ENV=production deno run -A npm:astro build && deno run -A ./output.ts",
    "postinstall": "patch-package",
    "preview": "astro preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:bun": "bun run --bun playwright test",
    "test:e2e:deno": "cross-env PW_DISABLE_TS_ESM=true deno run --allow-all npm:playwright test",
    "test:e2e:ui": "bun run --bun playwright test --ui",
    "test:e2e:ui:bun": "playwright test --ui",
    "test:e2e:ui:deno": "cross-env PW_DISABLE_TS_ESM=true deno run --allow-all npm:playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "test:run": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@analogjs/astro-angular": "^2.7.1",
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/react": "^6.0.5",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.2",
    "@nanostores/preact": "^1.1.0",
    "@nanostores/react": "^1.1.0",
    "@nanostores/solid": "^1.1.1",
    "@nanostores/vue": "^1.1.0",
    "astro": "^7.1.1",
    "cookie": "^2.0.1",
    "islands-integrations": "file:./.integrations",
    "nanostores": "^1.5.2",
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.0",
    "tslib": "^2.8.1",
    "twig": "^3.0.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular-devkit/architect": "^0.2201.6",
    "@angular-devkit/schematics": "^22.1.6",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/language-service": "^22.1.4",
    "@babel/core": "^7.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@solidjs/testing-library": "^0.8.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/vue": "^8.1.0",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/twig": "^1.12.17",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "angular-eslint": "^22.2.0",
    "better-npm-audit": "^3.11.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-preact": "^2.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-solid": "^0.17.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "js-beautify": "^2.0.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
