---
import AlpineStore from "../../framework/alpine/Store";
import AngularStore from "../../framework/angular/Store.component";
import EmberStore from "../../framework/ember/Store.gts";
import JQueryStore from "../../framework/jquery/Store";
import LitStore from "../../framework/lit/Store";
import PreactStore from "../../framework/preact/Store";
import QwikStore from "../../framework/qwik/Store";
import ReactStore from "../../framework/react/Store";
import SolidStore from "../../framework/solid/Store";
import StencilStore from "../../framework/stencil/Store";
import SvelteStore from "../../framework/svelte/Store.svelte";
import TwigStore from "../../framework/twig/Store.twig";
import VanillaStore from "../../framework/vanilla/Store";
import VueStore from "../../framework/vue/Store.vue";
import styles from "../../styles/index.css?url";
---
<html lang="en">
    <head>
        <link href={styles} rel="stylesheet" />
        <script>
            // Expose the shared framework Nano Store so string-rendered islands
            // (such as the VanillaJS and jQuery stores) can subscribe to it before they hydrate.
            import { framework } from "../../stores/framework";
            window.Stores = window.Stores || {};
            window.Stores["framework"] = framework;
        </script>
    </head>
    <body>
        <div class="card-grid">
            <AlpineStore client:load />
            <AngularStore client:load />
            <EmberStore client:only="ember-astro" />
            <JQueryStore client:load />
            <LitStore client:load />
            <PreactStore client:only="preact" />
            <QwikStore client:load />
            <ReactStore client:only="react" />
            <SolidStore client:only="solid-js" />
            <StencilStore client:load />
            <SvelteStore client:only="svelte" />
            <TwigStore client:load />
            <VanillaStore client:load />
            <VueStore client:only="vue" />
        </div>
    </body>
</html>