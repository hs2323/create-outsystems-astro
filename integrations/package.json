{
  "name": "islands-integrations",
  "version": "1.0.1",
  "description": "Integrations for OutSystems Astro Islands",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "audit": "better-npm-audit audit",
    "build": "tsc",
    "format": "prettier . --check",
    "format:write": "prettier  --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublish": "tsc",
    "process": "tsc && rm -rf ../template/.integrations && mv dist ../template/.integrations && cp package.json ../template/.integrations/package.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marko/compiler": "^5.43.2",
    "@qwik.dev/core": "^2.0.0-rc.5",
    "@stencil/core": "^4.45.3",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.11",
    "jquery": "^4.0.0",
    "marko": "^6.4.13",
    "twig": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/alpinejs": "^3.17.0",
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/twig": "^1.12.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-npm-audit": "^4.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
