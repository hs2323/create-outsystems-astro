{
  "name": "islands-integrations",
  "version": "0.11.2",
  "description": "Integrations for OutSystems Astro Islands",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "audit:bun": "bun audit --ignore=CVE-2026-14257",
    "audit:deno": "deno audit --ignore CVE-2026-14257",
    "audit:npm": "better-npm-audit audit --exclude GHSA-mh99-v99m-4gvg",
    "audit:pnpm": "pnpm audit --ignore GHSA-mh99-v99m-4gvg",
    "audit:yarn": "yarn npm audit --ignore GHSA-mh99-v99m-4gvg",
    "build": "tsc",
    "format": "prettier . --check",
    "format:write": "prettier  --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublish": "tsc",
    "process": "tsc && mv dist ../template/.integrations && cp package.json ../template/.integrations/package.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "astro": "^7.1.1",
    "twig": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.1",
    "@types/twig": "^1.12.17",
    "better-npm-audit": "^3.11.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  },
  "resolutions": {
    "fast-uri": "^3.1.4"
  }
}
