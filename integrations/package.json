{
  "name": "islands-integrations",
  "version": "0.13.0",
  "description": "Integrations for OutSystems Astro Islands",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "audit": "better-npm-audit audit",
    "build": "tsc",
    "format": "prettier . --check",
    "format:write": "prettier  --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepublish": "tsc",
    "process": "tsc && mv dist ../template/.integrations && cp package.json ../template/.integrations/package.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qwik.dev/core": "^2.0.0-beta.43",
    "astro": "^7.3.3",
    "twig": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/twig": "^1.12.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-npm-audit": "^3.11.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.11.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
