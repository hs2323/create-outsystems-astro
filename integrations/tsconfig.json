{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "alpine/**/*.ts",
    "jquery/**/*.ts",
    "lit/**/*.ts",
    "marko/**/*.ts",
    "qwik/**/*.ts",
    "stencil/**/*.ts",
    "twig/**/*.ts",
    "vanilla/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
